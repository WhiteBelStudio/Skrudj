# Skrudj environment template
# Copy to .env for local use. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Telegram
TELEGRAM_BOT_TOKEN=

# VK community integration
VK_GROUP_TOKEN=
VK_CALLBACK_SECRET=
VK_GROUP_ID=
VK_CONFIRMATION_CODE=
VK_CALLBACK_HOST=0.0.0.0
VK_CALLBACK_PORT=8080

# Local SQLite database; replace with a PostgreSQL URL in production if needed.
DATABASE_URL=sqlite+aiosqlite:///./data/skrudj.sqlite3

# Optional admin IDs (use platform-specific IDs; do not put display names here)
TELEGRAM_ADMIN_IDS=
VK_ADMIN_IDS=

# Broadcast safety
BROADCAST_DRY_RUN=true
BROADCAST_BATCH_SIZE=20
BROADCAST_DELAY_SECONDS=1

# Media limits
MAX_PHOTOS_PER_LISTING=5
MAX_UPLOAD_SIZE_MB=10
